[Desktop Entry]
Comment=Identity Wallet for people to manage Decentralized Identities and Verifiable Credentials
Exec=/usr/bin/oidwallet %U
Icon=oidwallet
Name=OIDwallet
Terminal=false
Type=Application
MimeType=x-scheme-handler/openid;x-scheme-handler/openid4vp;x-scheme-handler/openid-credential-offer
